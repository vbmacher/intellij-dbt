<?xml version="1.0" encoding="UTF-8"?>

<idea-plugin require-restart="false">
    <id>com.github.vbmacher.intellij-dbt</id>
    <name>dbt</name>
    <category>Languages</category>
    <version>2026.2</version>
    <idea-version since-build="262.8665" until-build="262.*"/>
    <vendor email="pjakubco@gmail.com" url="https://github.com/vbmacher">Peter Jakubčo</vendor>

    <description><![CDATA[
      Support for <a href="https://www.getdbt.com/">dbt</a> projects.

      Issue tracking at <a href="https://github.com/vbmacher/intellij-dbt/issues">GitHub</a>.
    ]]></description>

    <change-notes><![CDATA[
      <ul>
      <li>2026.2: Community navigation for dbt resources, macros, variables, YAML properties, SQL symbols, selectors and optional local metadata.</li>
      </ul>
    ]]>
    </change-notes>

    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.plugins.yaml</depends>
    <depends>com.intellij.modules.json</depends>

    <extensions defaultExtensionNs="com.intellij">
        <psi.referenceContributor implementation="com.github.vbmacher.intellij.dbt.DbtReferenceContributor"/>
        <gotoDeclarationHandler implementation="com.github.vbmacher.intellij.dbt.DbtGotoDeclarationHandler"/>
        <lang.findUsagesProvider language="dbt-symbol" implementationClass="com.github.vbmacher.intellij.dbt.DbtFindUsagesProvider"/>
        <targetElementEvaluator language="TEXT" implementationClass="com.github.vbmacher.intellij.dbt.DbtTargetElementEvaluator"/>
        <targetElementEvaluator language="Markdown" implementationClass="com.github.vbmacher.intellij.dbt.DbtTargetElementEvaluator"/>
        <findUsagesHandlerFactory implementation="com.github.vbmacher.intellij.dbt.DbtFindUsagesHandlerFactory" order="first"/>
        <referencesSearch implementation="com.github.vbmacher.intellij.dbt.DbtReferencesSearch"/>
    </extensions>
    <actions>
        <action id="Dbt.Properties" class="com.github.vbmacher.intellij.dbt.DbtPropertiesAction" text="dbt Properties" description="Navigate to properties of the current resource">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
        <action id="Dbt.Dependencies" class="com.github.vbmacher.intellij.dbt.DbtDependenciesAction" text="dbt Dependencies" description="Navigate resolved parents, children, and their call sites">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
