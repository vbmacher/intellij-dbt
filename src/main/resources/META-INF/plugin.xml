<?xml version="1.0" encoding="UTF-8"?>

<idea-plugin require-restart="false">
    <id>com.github.vbmacher.intellij-dbt</id>
    <name>dbt Workspace</name>
    <category>Languages</category>
    <version>1.1.0</version>
    <idea-version since-build="262.8665" until-build="262.*"/>
    <vendor email="pjakubco@gmail.com" url="https://github.com/vbmacher">Peter Jakubčo</vendor>

    <description><![CDATA[
      <p>Navigate <a href="https://www.getdbt.com/">dbt</a> projects in IntelliJ IDEA, including Community Edition.</p>
      <ul>
        <li>TextMate syntax highlighting for dbt SQL/Jinja, YAML/Jinja and Markdown/Jinja templates.</li>
        <li>Go to Declaration and Find Usages for models, sources, macros, variables, documentation and YAML properties.</li>
        <li>Browse resource properties and dependencies, including parents, children and their reference locations.</li>
        <li>Use gutter markers to open related properties, definitions, dependencies and callers.</li>
        <li>Follow SQL CTEs, columns, macro parameters, selectors and Semantic Layer references.</li>
        <li>Use local source files and optionally selected JSON or Parquet metadata for navigation.</li>
      </ul>
      <p>Open a directory containing <code>dbt_project.yml</code> to get started. Enable the bundled YAML plugin.
      SQL navigation works with plain-text files and does not require Database Tools.
      Enable the bundled TextMate Bundles plugin for syntax highlighting.
      Python model navigation additionally requires the free Python Community Edition plugin.</p>
      <p>Browse interactive lineage and documentation in the dbt tool window, run model commands and SQL previews,
      inspect native hover documentation and unresolved-reference warnings, and convert SQL relations with Copy for Target DB / Paste as dbt Refs.</p>
      <p><a href="https://github.com/vbmacher/intellij-dbt/blob/main/docs/README.md">User guide</a> ·
      <a href="https://github.com/vbmacher/intellij-dbt">Source code</a> ·
      <a href="https://github.com/vbmacher/intellij-dbt/issues">Issue tracker</a></p>
    ]]></description>

    <change-notes><![CDATA[
      <ul>
        <li>1.1.0: Interactive lineage, documentation sidebar and native hover, dbt Runner and previews, unresolved-reference warnings, SQL clipboard conversion.</li>
        <li>1.0.0: Initial release with Go to Declaration and Find Usages for dbt resources, macros, variables, documentation and YAML properties.</li>
        <li>Resource properties and dependency browsing with navigation to reference locations.</li>
        <li>Gutter navigation with ambiguity and metadata status tooltips.</li>
        <li>Optional bundled TextMate integration with SQL/Jinja, YAML/Jinja and Markdown/Jinja highlighting.</li>
        <li>SQL symbol, selector and Semantic Layer navigation, with optional Python models and local JSON or Parquet metadata.</li>
      </ul>
    ]]>
    </change-notes>

    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.plugins.yaml</depends>
    <depends>com.intellij.modules.json</depends>
    <depends>com.intellij.modules.jcef</depends>
    <depends>intellij.testRunner.plugin</depends>
    <depends optional="true" config-file="textmate.xml">org.jetbrains.plugins.textmate</depends>

    <!-- Ports of the dbt workspace, navigation and lineage; registration order is priority order. -->
    <extensionPoints>
        <extensionPoint name="declarationSource" interface="com.github.vbmacher.intellij.dbt.project.DbtDeclarationSource" dynamic="true"/>
        <extensionPoint name="referenceProvider" interface="com.github.vbmacher.intellij.dbt.navigation.DbtReferenceProvider" dynamic="true"/>
        <extensionPoint name="dependencySource" interface="com.github.vbmacher.intellij.dbt.lineage.DbtDependencySource" dynamic="true"/>
    </extensionPoints>

    <extensions defaultExtensionNs="com.github.vbmacher.intellij-dbt">
        <declarationSource implementation="com.github.vbmacher.intellij.dbt.navigation.sql.DbtSqlProjections"/>
        <declarationSource implementation="com.github.vbmacher.intellij.dbt.navigation.DbtBuiltinSources"/>
        <declarationSource implementation="com.github.vbmacher.intellij.dbt.project.DbtEnvironmentSource"/>
        <declarationSource implementation="com.github.vbmacher.intellij.dbt.metadata.DbtArtifactSource"/>
        <declarationSource implementation="com.github.vbmacher.intellij.dbt.metadata.DbtParquetArtifactSource"/>

        <referenceProvider implementation="com.github.vbmacher.intellij.dbt.navigation.jinja.DbtJinjaNavigation"/>
        <referenceProvider implementation="com.github.vbmacher.intellij.dbt.navigation.yaml.DbtYamlNavigation"/>
        <referenceProvider implementation="com.github.vbmacher.intellij.dbt.lineage.DbtSelectorNavigation"/>
        <referenceProvider implementation="com.github.vbmacher.intellij.dbt.navigation.python.DbtPythonNavigation"/>
        <referenceProvider implementation="com.github.vbmacher.intellij.dbt.navigation.sql.DbtSqlNavigation"/>
        <referenceProvider implementation="com.github.vbmacher.intellij.dbt.navigation.sql.DbtFunctionParameters"/>

        <dependencySource implementation="com.github.vbmacher.intellij.dbt.metadata.DbtArtifactSource"/>
        <dependencySource implementation="com.github.vbmacher.intellij.dbt.metadata.DbtParquetArtifactSource"/>
    </extensions>

    <extensions defaultExtensionNs="com.intellij">
        <completion.contributor language="any" implementationClass="com.github.vbmacher.intellij.dbt.ide.DbtCompletionContributor"/>
        <defaultLiveTemplates file="/liveTemplates/Dbt.xml"/>
        <renamePsiElementProcessor implementation="com.github.vbmacher.intellij.dbt.ide.DbtRenameProcessor"/>
        <refactoring.safeDeleteProcessor implementation="com.github.vbmacher.intellij.dbt.ide.DbtSafeDelete"/>
        <localInspection language="" shortName="DbtStaticAnalysis" displayName="dbt SQL, macro arguments and contracts" groupName="dbt" enabledByDefault="true" level="WARNING" implementationClass="com.github.vbmacher.intellij.dbt.ide.DbtStaticInspection"/>
        <lang.parameterInfo language="TEXT" implementationClass="com.github.vbmacher.intellij.dbt.ide.DbtParameterInfoHandler"/>
        <lang.parameterInfo language="yaml" implementationClass="com.github.vbmacher.intellij.dbt.ide.DbtParameterInfoHandler"/>
        <lang.parameterInfo language="SQL" implementationClass="com.github.vbmacher.intellij.dbt.ide.DbtParameterInfoHandler"/>
        <lang.parameterInfo language="textmate" implementationClass="com.github.vbmacher.intellij.dbt.ide.DbtParameterInfoHandler"/>
        <platform.backend.documentation.symbolTargetProvider implementation="com.github.vbmacher.intellij.dbt.ide.DbtSymbolDocumentationTargetProvider"/>
        <platform.backend.documentation.psiTargetProvider implementation="com.github.vbmacher.intellij.dbt.ide.DbtBuiltinPsiDocumentationTargetProvider"/>
        <platform.backend.documentation.linkHandler implementation="com.github.vbmacher.intellij.dbt.ide.DbtBuiltinDocumentationLinkHandler"/>
        <projectService serviceInterface="com.github.vbmacher.intellij.dbt.project.DbtDocumentationNavigation" serviceImplementation="com.github.vbmacher.intellij.dbt.ide.DbtBuiltinDocumentationNavigation"/>
        <projectService serviceInterface="com.github.vbmacher.intellij.dbt.ide.DbtBuiltinDocumentationSource" serviceImplementation="com.github.vbmacher.intellij.dbt.ide.DbtBuiltinDocumentationLoader"/>
        <externalAnnotator language="" implementationClass="com.github.vbmacher.intellij.dbt.ide.DbtUnresolvedAnnotator"/>
        <localInspection language="" shortName="DbtUnresolvedReference" displayName="Unresolved dbt reference" groupName="dbt" enabledByDefault="true" level="WARNING" implementationClass="com.github.vbmacher.intellij.dbt.ide.DbtUnresolvedReferenceInspection"/>
        <notificationGroup id="dbt Workspace" displayType="BALLOON" isLogByDefault="true"/>
        <projectConfigurable id="dbt.workspace" displayName="dbt Workspace" instance="com.github.vbmacher.intellij.dbt.ide.DbtSettingsConfigurable"/>
        <toolWindow id="dbt" anchor="bottom" factoryClass="com.github.vbmacher.intellij.dbt.ide.DbtToolWindowFactory" icon="/icons/dbt/table.svg"/>
        <codeInsight.lineMarkerProvider language="" implementationClass="com.github.vbmacher.intellij.dbt.ide.DbtLineMarkerProvider"/>
        <iconProvider implementation="com.github.vbmacher.intellij.dbt.ide.DbtIconProvider" order="first"/>
        <psi.referenceContributor implementation="com.github.vbmacher.intellij.dbt.ide.DbtReferenceContributor"/>
        <psi.implicitReferenceProvider implementation="com.github.vbmacher.intellij.dbt.ide.DbtImplicitReferenceProvider"/>
        <lang.symbolSearchTarget forClass="com.github.vbmacher.intellij.dbt.ide.DbtPsiSymbol" implementationClass="com.github.vbmacher.intellij.dbt.ide.DbtSymbolSearchTargetFactory"/>
        <searcher forClass="com.intellij.find.usages.api.UsageSearchParameters" implementationClass="com.github.vbmacher.intellij.dbt.ide.DbtSymbolUsageSearcher"/>
        <lang.findUsagesProvider language="dbt-symbol" implementationClass="com.github.vbmacher.intellij.dbt.ide.DbtFindUsagesProvider"/>
        <targetElementEvaluator language="TEXT" implementationClass="com.github.vbmacher.intellij.dbt.ide.DbtTargetElementEvaluator"/>
        <targetElementEvaluator language="Markdown" implementationClass="com.github.vbmacher.intellij.dbt.ide.DbtTargetElementEvaluator"/>
        <targetElementEvaluator language="yaml" implementationClass="com.github.vbmacher.intellij.dbt.ide.DbtTargetElementEvaluator"/>
        <findUsagesHandlerFactory implementation="com.github.vbmacher.intellij.dbt.ide.DbtFindUsagesHandlerFactory" order="first"/>
        <referencesSearch implementation="com.github.vbmacher.intellij.dbt.ide.DbtReferencesSearch"/>
    </extensions>
    <extensions defaultExtensionNs="JavaScript">
        <JsonSchema.ProviderFactory implementation="com.github.vbmacher.intellij.dbt.ide.DbtYamlSchemaProvider"/>
    </extensions>
    <actions>
        <action id="Dbt.ChangeImpact" class="com.github.vbmacher.intellij.dbt.ide.DbtImpactAction" text="dbt Change Impact">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action id="Dbt.CopyForTarget" class="com.github.vbmacher.intellij.dbt.ide.DbtCopyForTargetAction" text="Copy for Target DB">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="EditMenu" anchor="last"/>
            <keyboard-shortcut keymap="$default" first-keystroke="control shift C"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="meta shift C"/>
        </action>
        <action id="Dbt.PasteAsRefs" class="com.github.vbmacher.intellij.dbt.ide.DbtPasteAsRefsAction" text="Paste as dbt Refs">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="EditMenu" anchor="last"/>
            <keyboard-shortcut keymap="$default" first-keystroke="control shift V"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="meta shift V"/>
        </action>
        <action id="Dbt.Properties" class="com.github.vbmacher.intellij.dbt.ide.DbtPropertiesAction" text="dbt Properties" description="Navigate to properties of the current resource">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
        <action id="Dbt.Dependencies" class="com.github.vbmacher.intellij.dbt.ide.DbtDependenciesAction" text="dbt Dependencies" description="Navigate resolved parents, children, and their call sites">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
