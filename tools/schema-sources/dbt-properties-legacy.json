{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "dbt properties (legacy)",
  "type": "object",
  "properties": {
    "version": {
      "enum": [
        2
      ]
    },
    "models": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "$ref": "dbt-common.json#/definitions/resource"
          }
        },
        {
          "type": "string",
          "pattern": "\\{[{%]"
        }
      ]
    },
    "seeds": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "$ref": "dbt-common.json#/definitions/resource"
          }
        },
        {
          "type": "string",
          "pattern": "\\{[{%]"
        }
      ]
    },
    "snapshots": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "$ref": "dbt-common.json#/definitions/resource"
          }
        },
        {
          "type": "string",
          "pattern": "\\{[{%]"
        }
      ]
    },
    "sources": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "$ref": "dbt-common.json#/definitions/source"
          }
        },
        {
          "type": "string",
          "pattern": "\\{[{%]"
        }
      ]
    },
    "macros": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "$ref": "dbt-common.json#/definitions/macro"
          }
        },
        {
          "type": "string",
          "pattern": "\\{[{%]"
        }
      ]
    },
    "exposures": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "owner": {
                "type": "object"
              },
              "depends_on": {
                "anyOf": [
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  {
                    "type": "string",
                    "pattern": "\\{[{%]"
                  }
                ]
              }
            },
            "required": [
              "name"
            ],
            "additionalProperties": true
          }
        },
        {
          "type": "string",
          "pattern": "\\{[{%]"
        }
      ]
    }
  },
  "required": [],
  "additionalProperties": true,
  "patternProperties": {
    "^semantic_models$": false,
    "^metrics$": false,
    "^saved_queries$": false,
    "^unit_tests$": false,
    "^functions$": false
  }
}
